# ============================================
# SNAKE MCQ CHALLENGE - ENVIRONMENT VARIABLES
# ============================================

# Copy this file to .env and update values for your deployment

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=snake_mcq
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=2
DB_POOL_MAX=10

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_12345
JWT_EXPIRY=24h
SESSION_SECRET=your_session_secret_change_this_in_production

# ============================================
# ADMIN CREDENTIALS
# ============================================
# Change these to secure values in production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ============================================
# FRONTEND CONFIGURATION
# ============================================
FRONTEND_URL=http://localhost:8080

# ============================================
# SOCKET.IO CONFIGURATION
# ============================================
ENABLE_SOCKET_IO=true
SOCKET_IO_PORT=3001

# ============================================
# GAME CONFIGURATION
# ============================================
READING_TIME_SECONDS=20
TOTAL_QUESTIONS=10
MAX_CORRECT_SCORE=100
READING_BONUS_POINTS=2
MAX_CONCURRENT_PLAYERS=200

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# PRODUCTION SETTINGS (Update for production)
# ============================================
# Uncomment and set these for production deployment

# NODE_ENV=production
# DB_HOST=prod-db-server.example.com
# DB_PASSWORD=secure_password_here
# FRONTEND_URL=https://your-domain.com
# JWT_SECRET=production_jwt_secret_key_very_secure
# SESSION_SECRET=production_session_secret_very_secure
# ADMIN_USERNAME=admin_prod
# ADMIN_PASSWORD=$2b$10$... (use bcrypt hash)
# LOG_LEVEL=warn
